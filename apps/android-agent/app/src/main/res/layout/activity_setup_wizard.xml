<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Setup Wizard"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link this Android phone with your family's Tracker dashboard."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- Step 1: Server URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. BACKEND SERVER URL"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/card_dark"
            android:textColor="@color/text_primary"
            android:padding="10dp"
            android:textSize="12sp"
            android:text="http://10.0.2.2:3000"
            android:layout_marginBottom="16dp" />

        <!-- Step 2: 6-Digit Code / QR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. PAIRING CODE (FROM PARENT DASHBOARD)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPairingCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/card_dark"
            android:textColor="@color/amber_primary"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLength="6"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Scan QR Code"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/border_dark"
            android:layout_marginBottom="24dp" />

        <!-- Step 3: Permissions Walkthrough -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. REQUIRED SYSTEM PERMISSIONS"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGrantUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Grant Usage Access"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/card_dark"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGrantAccessibility"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Enable Event Detection"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/card_dark"
            android:layout_marginBottom="24dp" />

        <!-- Complete Pairing Button -->
        <Button
            android:id="@+id/btnCompleteSetup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Complete Setup &amp; Link"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="@color/amber_primary" />

        <TextView
            android:id="@+id/tvSetupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rose_accent"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>

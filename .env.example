# Environment Configuration

# Database Configuration
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=tracker_secret_pass
POSTGRES_DB=tracker_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tracker_user:tracker_secret_pass@localhost:5432/tracker_db?schema=public

# Backend API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production
COOKIE_SECRET=super_secret_cookie_key_change_in_production
CORS_ORIGIN=http://localhost:5173

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@tracker.family

# Web Dashboard Configuration
VITE_API_BASE_URL=http://localhost:3000/api
